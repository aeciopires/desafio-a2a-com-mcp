# Copy to .env (make install does it) and fill in. Never commit .env.
# Empty values fall back to the defaults documented in docs/variaveis-de-ambiente.md.

# --- Secrets (required). `make secret` generates both. ---
# requestState integrity key: at least 32 random bytes (64 hex chars).
REQUEST_STATE_SECRET=
GRAFANA_ADMIN_PASSWORD=

# --- MCP server ---
MCP_HOST=
MCP_PORT=
MCP_PATH=
REQUEST_STATE_TTL_SECONDS=
DATA_DIR=

# --- Agent ---
AGENT_HOST=
AGENT_PORT=
AGENT_PATH=
AGENT_PUBLIC_URL=
MCP_URL=
MCP_TIMEOUT_SECONDS=

# --- Logging ---
LOG_LEVEL=
LOG_FORMAT=

# --- Observability (host ports and settings) ---
PROMETHEUS_PORT=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
JAEGER_UI_PORT=
JAEGER_OTLP_HTTP_PORT=
LOKI_PORT=
LOKI_RETENTION_PERIOD=
ALLOY_UI_PORT=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=

          "expr": "sum(rate({__name__=~\"otelcol_receiver_refused_spans(_total)?\", receiver!=\"\"}[5m])) / sum(rate({__name__=~\"otelcol_receiver_accepted_spans(_total)?\", receiver!=\"\"}[5m]))",
          "legendFormat": "Refused Ratio"
        },
        {
          "expr": "sum(rate({__name__=~\"otelcol_exporter_send_failed_spans(_total)?\", exporter!=\"\"}[5m])) / sum(rate({__name__=~\"otelcol_exporter_sent_spans(_total)?\", exporter!=\"\"}[5m]))",
          "legendFormat": "Failed Ratio"
        }
      ],
      "title": "Error Rates",
      "type": "timeseries"
    }
  ],
